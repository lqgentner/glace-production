    given-names: Luis Q.
    email: luis.gentner@geo.uzh.ch
    orcid: https://orcid.org/0009-0006-4453-0881
    affiliation: University of Zurich, Department of Geography
license: MIT
repository-code: https://github.com/lqgentner/glace-production
version: "1.0"
keywords:
  - Sentinel-1
  - SAR
  - InSAR coherence
  - backscatter
  - glaciers
  - Alps
  - pipeline
