# Copy to .env and fill in. Every `pixi run` sources .env (scripts/utils/pixi-activate.sh).
# Keys of object stores never go here: they live in ~/.aws/credentials, under the
# profiles named below.

# --- Data directories --------------------------------------------------------
# Root of every relative path in config/: a local directory or an s3:// URI. Required.
GLACIERS_DATA_DIR=
# Validation store (locations, samples, runs), rendered tables and figures.
GLACIERS_MODELS_DIR=
GLACIERS_REPORTS_DIR=
GLACIERS_FIGURES_DIR=
# Local scratch: staged DEMs, MODIS series, temporary mosaics.
FREEZEBASE_CACHE=

# --- Object store holding GLACIERS_DATA_DIR (when it is an s3:// URI) --------
# AWS profile. The endpoint may also come from that profile's endpoint_url.
GLACIERS_S3_PROFILE=
GLACIERS_S3_ENDPOINT_URL=

# --- Copernicus Data Space Ecosystem (Sentinel-1 bursts) ---------------------
CDSE_USERNAME=
CDSE_PASSWORD=
# S3 access to the parent SLCs, for bursts the on-demand service fails to extract.
CDSE_S3_PROFILE=
CDSE_S3_ENDPOINT_URL=https://eodata.dataspace.copernicus.eu

# --- Google Earth Engine (MODIS snow cover for the compositing window) -------
EE_SERVICE_ACC_EMAIL=
EE_SERVICE_ACC_KEY_FILE=

# --- NASA Earthdata (RGI 7.0, Global Seasonal coherence) ---------------------
EOSDIS_USERNAME=
EOSDIS_PASSWORD=

# --- ESA SNAP (gpt comes with the pixi environment) --------------------------
SNAP_MAX_WORKERS=4
SNAP_MAX_RAM_GB=36
