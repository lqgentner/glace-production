{# Keys forwarded from local .env unchanged #}
{% set passthrough_keys = [
   'EE_SERVICE_ACC_EMAIL',
   'EOSDIS_USERNAME',
   'EOSDIS_PASSWORD',
   'CDSE_USERNAME',
   'CDSE_PASSWORD',
   'CDSE_S3_ENDPOINT_URL',
   'CDSE_S3_PROFILE',
   'GLACIERS_S3_ENDPOINT_URL',
   'GLACIERS_S3_PROFILE',
   'GLACIERS_S3_REQUEST_CHECKSUM_CALCULATION',
   'GLACIERS_S3_RESPONSE_CHECKSUM_VALIDATION',
] %}
{% for key in passthrough_keys %}
{% if key in local_env %}
{{ key }}={{ local_env[key] }}
{% endif %}
{% endfor %}

{# Only genuine per-deployment overrides belong here. In-container paths that
   never vary — SNAP_BIN and the /app/secrets/* locations of the AWS credentials
   file and the EE key — are declared once in the Dockerfile instead. #}
# Overrides set by Ansible for flavor {{ openstack_flavor }}
SNAP_MAX_WORKERS={{ snap_max_workers }}
SNAP_MAX_RAM_GB={{ snap_max_ram_gb }}
FREEZEBASE_CACHE=/tmp/freezebase-cache
# The workers always write to the object store, whatever the local .env points
# at; they only produce composites, so no reports, figures or models directory.
GLACIERS_DATA_DIR={{ glaciers_data_dir }}
