{# AWS shared-credentials file for the VMs. The profile list is derived from the
   *_S3_PROFILE entries in the local .env, so naming a profile there is the only
   thing needed to get its keys onto the VMs. Values are looked up section by
   section, so unrelated profiles never leave this machine. #}
{% for profile in local_env | dict2items | selectattr('key', 'search', '_S3_PROFILE$')
                            | map(attribute='value') | select | unique | sort %}
[{{ profile }}]
aws_access_key_id = {{ lookup('ini', 'aws_access_key_id', section=profile, file=aws_credentials_src) }}
aws_secret_access_key = {{ lookup('ini', 'aws_secret_access_key', section=profile, file=aws_credentials_src) }}

{% endfor %}
